{
  "name": "vodd",
  "private": true,
  "description": "formatting for the embedded assets and the browser tests for the debugger",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.6.2"
  },
  "scripts": {
    "format": "prettier --write \"src/templates/**/*.css\" \"src/hypermedia/**/*.js\"",
    "format:check": "prettier --check \"src/templates/**/*.css\" \"src/hypermedia/**/*.js\"",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  }
}
