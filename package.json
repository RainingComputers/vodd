{
  "name": "vodd",
  "private": true,
  "description": "formatting for the embedded templates and the browser tests for the debugger",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.6.2",
    "prettier-plugin-jinja-template": "^2.1.0"
  },
  "scripts": {
    "format": "prettier --write \"src/templates/**/*.{html,js,css}\" \"src/hypermedia/**/*.{html,js,css}\"",
    "format:check": "prettier --check \"src/templates/**/*.{html,js,css}\" \"src/hypermedia/**/*.{html,js,css}\"",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  }
}
